# LLM backend for q → SQL fragment translation.
# Requests with no `q` (bbox-only tiles) work even when no LLM is configured.
#
# Two intended deployments:
#
# (1) OpenAI cloud:
#       OPENAI_API_KEY=sk-...
#       OPENAI_MODEL=gpt-5.1
#       (leave OPENAI_BASE_URL unset)
#
# (2) llama.cpp llama-server (local or any OpenAI-compatible endpoint):
#       OPENAI_BASE_URL=http://127.0.0.1:18091/v1
#       OPENAI_API_KEY=dummy   # the server ignores it
#       OPENAI_MODEL=qwen-a3b  # whatever alias the llama-server was started with
#
# Set at least one of OPENAI_API_KEY / OPENAI_BASE_URL or q-filters return 503.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.1
# LLM call timeout in seconds. Bump to 30-60 for local llama-server with larger
# models (e.g. Qwen3-30B-A3B at ~30 tok/s).
LLM_TIMEOUT_S=8

# DuckDB resource caps applied at connection open.
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4
# Per-query wall-clock timeout. Cancels via DuckDB connection.interrupt().
DUCKDB_QUERY_TIMEOUT_S=15

# Server bind config.
HOST=127.0.0.1
PORT=8080
